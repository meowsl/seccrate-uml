@startuml 02-activity
' Деятельность прецедента «Скачать артефакт».
' Дорожки — классы с диаграммы 1.3. Подписи шагов — их методы.
' Те же развилки, что фрагменты alt / opt / par на диаграмме 1.4.

skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam dpi 140
skinparam ActivityFontSize 13
skinparam ActivityDiamondFontSize 12
skinparam ArrowFontSize 12
skinparam swimlaneWidth 240
skinparam swimlaneBorderColor #3D4A3E

title Диаграмма деятельности\nПрецедент «Скачать артефакт»\n(овал с диаграммы прецедентов)

|Разработчик|
start
:Запросить файл\nGET /repository/<repo>/<path>\nс токеном;

|Gateway|
:handleRepository(w, r)\nPOST /internal/v1/gateway/resolve;

|ResolveAPI|
:_user_from_token(db, token);
:AccessControl.can_gateway_read(db, user, repo, scopes);
:AccessControl.can_gateway_read_path(db, user, repo, path, scopes);

if (оба вызова\nвернули true?) then (да)
else (нет)
  |Разработчик|
  :Отказ 403.\nНа последовательности это фрагмент break;
  stop
endif

|ResolveAPI|
:ArtifactIndex.find_artifact(db, repo, path);

if (артефакт найден?) then (нет)
  :UpstreamClient.fetch_miss(db, s3, bucket, user, repo, path)\nвнутри: fetch_upstream;\nSsrfGuard.assert_safe_http_url(url, hardened, allowlist);\nBlobStore.put_bytes(client, bucket, sha256, data, content_type);
  :ArtifactIndex.ensure_pending_scan(db, artifact, "proxy")\nзадача ScanJob, origin=proxy, priority=live;
else (да)
  :ensure_pending_scan\nничего не делает,\nесли статус уже не pending;
endif

if (effective_sync_wait > 0?\nне Docker и файл небольшой) then (да)
  |ResolveAPI|
  :wait_ready(factory, artifactId, seconds).\nОдновременно, фрагмент par:;
  |Worker|
  :ScanQueue.claim_queued_scan(db)\nсначала live, SKIP LOCKED;
  :process_job(db, client, bucket, job);
  :BlobStore.download_to(client, bucket, sha256, файл);
  :ScanEngine.run_all(path, engines);
  repeat
    :Scanner.scan(path, extra)\nобъект GrypeScanner,\nTrivyScanner или OsvScanner;
  repeat while (есть ещё\nвключённый сканер?) is (да)
  ->нет;
  :ScanEngine.worst(outcomes, threshold);
  if (вердикт?) then (PASS)
    :artifact.status = available\nсохранить ScanVerdict;
  elseif (FAIL)
    :Findings.sync_findings(db, art, items, sla_due)\nfirstSeenAt не сбрасывается;\nartifact.status = blocked;
  else (ERROR)
    :artifact.status = quarantine\nстарые Finding не стираются;
  endif
else (нет)
  |ResolveAPI|
  :Ждать не будем.\nВоркер заберёт задачу позже,\nклиент увидит Retry-After;
endif

|ResolveAPI|
:ArtifactIndex.decision_for_get(db, settings, artifact);

if (ответ action?) then (stream)
  |Gateway|
  :streamBlob(w, r, out)\nGET /internal/v1/blobs/{sha256};
  |Разработчик|
  :Получить байты файла;
  stop
else (blocked, pending\nили quarantine)
  |Разработчик|
  :Карточка блокировки\nили «подождите».\nФайла нет;
  stop
endif

legend bottom
  Это алгоритм прецедента «Скачать артефакт».
  Имя в шаге — метод класса с диаграммы классов.
endlegend

@enduml
