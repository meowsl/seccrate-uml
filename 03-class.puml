@startuml 03-class
' Классы, которые реализуют прецедент «Скачать артефакт».
' У каждого метода есть стрелка с тем же именем на диаграмме последовательности.

skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam dpi 140
skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam classAttributeFontSize 11
skinparam wrapWidth 220
skinparam nodesep 16
skinparam ranksep 22

title Диаграмма классов\nКто выполняет прецедент «Скачать артефакт»

skinparam package {
  BackgroundColor #FBFBF8
  BorderColor #3D4A3E
  FontStyle bold
}

package "Граница и управление" #EEF3FA {
  class Gateway <<boundary>> {
    +handleRepository(w, r)
    +streamBlob(w, r, out)
  }
  class ResolveAPI <<control>> {
    +resolve(body, db, authorization): dict
    +_user_from_token(db, raw, api_key): User
    +_reject(exc): dict
    +stream_blob(sha256, authorization, range_header)
  }
  class AccessControl <<control>> {
    +can_gateway_read(db, user, repo, scopes, hardened): bool
    +can_gateway_read_path(db, user, repo, path, scopes, hardened): bool
  }
  class ArtifactIndex <<control>> {
    +find_artifact(db, repo, path): Artifact
    +ensure_pending_scan(db, artifact, origin): ScanJob
    +effective_sync_wait(db, artifact, settings): int
    +wait_ready(factory, artifactId, seconds, db, art)
    +decision_for_get(db, settings, artifact): dict
  }
  class UpstreamClient <<control>> {
    +fetch_miss(db, s3, bucket, user, repo, path): Artifact
    +fetch_upstream(db, s3, bucket, user, repo, path, timeout)
  }
  class SsrfGuard <<control>> {
    +assert_safe_http_url(url, hardened, allowlist): str
  }
  class BlobStore <<control>> {
    +put_bytes(client, bucket, sha256, data, content_type): str
    +download_to(client, bucket, sha256, dest)
  }
  class Worker <<control>> {
    +process_job(db, client, bucket, job)
    +run()
  }
  class ScanQueue <<control>> {
    +claim_queued_scan(db): ScanJob
  }
  class ScanEngine <<control>> {
    +run_all(path, engines, kind, osv_lockfile): ScanOutcome[]
    +worst(outcomes, threshold, fail_on_unknown): str
  }
  class Findings <<control>> {
    +sync_findings(db, art, items, sla_due): int
  }
}

package "Сканеры" #FBF3F0 {
  abstract class Scanner {
    +scan(path, extra): ScanOutcome
  }
  class GrypeScanner
  class TrivyScanner
  class OsvScanner
}

package "Сущности" #F4F7F0 {
  class User <<entity>> {
    username
    source
    isActive
  }
  class Repository <<entity>> {
    name
    type: hosted | proxy | group
    format
    blockSeverities
    upstreamUrl
  }
  class Artifact <<entity>> {
    path
    sha256
    status
  }
  class Blob <<entity>> {
    sha256
    s3Key
    size
  }
  class ScanJob <<entity>> {
    status
    origin
    priority
  }
  class ScanVerdict <<entity>> {
    fingerprint
    verdict
  }
  class Finding <<entity>> {
    vulnId
    severity
    scanner
    firstSeenAt
    status
  }
  enum ArtifactStatus {
    pending
    quarantine
    blocked
    available
    imported_unscanned
  }
}

Gateway --> ResolveAPI
ResolveAPI --> AccessControl
ResolveAPI --> ArtifactIndex
ResolveAPI --> UpstreamClient
UpstreamClient --> SsrfGuard
UpstreamClient --> BlobStore
Worker --> ScanQueue
Worker --> ScanEngine
Worker --> BlobStore
Worker --> Findings
ScanEngine --> "1..*" Scanner

Scanner <|-- GrypeScanner
Scanner <|-- TrivyScanner
Scanner <|-- OsvScanner

User "1" --> "*" Repository : читает по выдаче

Repository "1" *-- "0..*" Artifact
Artifact "*" --> "1" Blob
Artifact "1" *-- "0..*" ScanJob
Artifact "1" *-- "0..*" ScanVerdict
Artifact "1" *-- "0..*" Finding
Artifact --> ArtifactStatus

note bottom of Scanner
  run_all создаёт объект
  GrypeScanner, TrivyScanner
  или OsvScanner и вызывает scan.
  В коде это scanners/engines.py.
end note

legend bottom
  Методы со знаком + — те же имена, что на стрелках последовательности.
  <<boundary>> принимает запрос клиента. <<control>> выполняет шаг. <<entity>> хранит данные.
endlegend

@enduml
