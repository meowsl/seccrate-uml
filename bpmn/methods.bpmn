<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_SecCrate_Methods" targetNamespace="http://seccrate.local/bpmn" exporter="seccrate-uml">
  <bpmn:collaboration id="Collab_Methods">
    <bpmn:participant id="Pool_Dev" name="Разработчик (mvn / npm)" processRef="Process_Dev" />
    <bpmn:participant id="Pool_SecCrate" name="SecCrate — методы классов" processRef="Process_Methods" />
    <bpmn:messageFlow id="M_Request" sourceRef="Dev_Send" targetRef="GW_Handle" />
    <bpmn:messageFlow id="M_Deny" sourceRef="GW_End_Deny" targetRef="Dev_Denied" />
    <bpmn:messageFlow id="M_Ok" sourceRef="GW_End_Ok" targetRef="Dev_Got" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Dev" name="Разработчик" isExecutable="false">
    <bpmn:startEvent id="Dev_Start" name="Нужен пакет"></bpmn:startEvent>
    <bpmn:sendTask id="Dev_Send" name="Отправить GET /repository/&lt;repo&gt;/&lt;path&gt;"></bpmn:sendTask>
    <bpmn:eventBasedGateway id="Dev_Wait" name="ждать ответ"></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Dev_Denied" name="отказ"><bpmn:messageEventDefinition id="Dev_Denied_def" /></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Dev_End_Bad" name="Файла нет"></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Dev_Got" name="200 и файл"><bpmn:messageEventDefinition id="Dev_Got_def" /></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Dev_End_Ok" name="Пакет получен"></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Dev1" sourceRef="Dev_Start" targetRef="Dev_Send" />
    <bpmn:sequenceFlow id="F_Dev2" sourceRef="Dev_Send" targetRef="Dev_Wait" />
    <bpmn:sequenceFlow id="F_Dev3" sourceRef="Dev_Wait" targetRef="Dev_Denied" />
    <bpmn:sequenceFlow id="F_Dev4" sourceRef="Dev_Wait" targetRef="Dev_Got" />
    <bpmn:sequenceFlow id="F_Dev5" sourceRef="Dev_Denied" targetRef="Dev_End_Bad" />
    <bpmn:sequenceFlow id="F_Dev6" sourceRef="Dev_Got" targetRef="Dev_End_Ok" />
  </bpmn:process>
  <bpmn:process id="Process_Methods" name="Скачать артефакт: методы классов" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Methods">
      <bpmn:lane id="Lane_Gateway" name="Gateway"><bpmn:flowNodeRef>GW_Handle</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Deny</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_End_Deny</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Stream</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_End_Ok</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ResolveAPI" name="ResolveAPI"><bpmn:flowNodeRef>API_Resolve</bpmn:flowNodeRef><bpmn:flowNodeRef>API_User</bpmn:flowNodeRef><bpmn:flowNodeRef>API_Reject</bpmn:flowNodeRef><bpmn:flowNodeRef>API_StreamBlob</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_AccessControl" name="AccessControl"><bpmn:flowNodeRef>ACL_Read</bpmn:flowNodeRef><bpmn:flowNodeRef>ACL_Path</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Auth</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ArtifactIndex" name="ArtifactIndex"><bpmn:flowNodeRef>IDX_Find</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Found</bpmn:flowNodeRef><bpmn:flowNodeRef>IDX_Ensure</bpmn:flowNodeRef><bpmn:flowNodeRef>IDX_SyncWait</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Wait</bpmn:flowNodeRef><bpmn:flowNodeRef>Par_Fork</bpmn:flowNodeRef><bpmn:flowNodeRef>IDX_WaitReady</bpmn:flowNodeRef><bpmn:flowNodeRef>Par_Join</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef><bpmn:flowNodeRef>IDX_Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Action</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_UpstreamClient" name="UpstreamClient"><bpmn:flowNodeRef>UP_Miss</bpmn:flowNodeRef><bpmn:flowNodeRef>UP_Fetch</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_SsrfGuard" name="SsrfGuard"><bpmn:flowNodeRef>SSRF_Check</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Ssrf</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ScanQueue" name="ScanQueue"><bpmn:flowNodeRef>Q_Claim</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Worker" name="Worker"><bpmn:flowNodeRef>W_Process</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_BlobStore" name="BlobStore"><bpmn:flowNodeRef>BLOB_Put</bpmn:flowNodeRef><bpmn:flowNodeRef>BLOB_Download</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ScanEngine" name="ScanEngine"><bpmn:flowNodeRef>ENG_RunAll</bpmn:flowNodeRef><bpmn:flowNodeRef>ENG_Worst</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Verdict</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_VerdictMerge</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Scanner" name="Scanner"><bpmn:flowNodeRef>SC_Scan</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Findings" name="Findings"><bpmn:flowNodeRef>FND_Sync</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="GW_Handle" name="handleRepository(w, r)"></bpmn:serviceTask>
    <bpmn:serviceTask id="API_Resolve" name="resolve(body, db, authorization)"></bpmn:serviceTask>
    <bpmn:serviceTask id="API_User" name="_user_from_token(db, raw, api_key)"></bpmn:serviceTask>
    <bpmn:serviceTask id="ACL_Read" name="can_gateway_read(db, user, repo, scopes)"></bpmn:serviceTask>
    <bpmn:serviceTask id="ACL_Path" name="can_gateway_read_path(db, user, repo, path, scopes)"></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Auth" name="оба true?"></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IDX_Find" name="find_artifact(db, repo, path)"></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Found" name="найден?"></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="UP_Miss" name="fetch_miss(db, s3, bucket, user, repo, path)"></bpmn:serviceTask>
    <bpmn:serviceTask id="UP_Fetch" name="fetch_upstream(db, s3, bucket, user, repo, path)"></bpmn:serviceTask>
    <bpmn:serviceTask id="SSRF_Check" name="assert_safe_http_url(url, hardened, allowlist)"></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Ssrf" name="адрес разрешён?"></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BLOB_Put" name="put_bytes(client, bucket, sha256, data, content_type)"></bpmn:serviceTask>
    <bpmn:serviceTask id="IDX_Ensure" name="ensure_pending_scan(db, artifact, &quot;proxy&quot;)"></bpmn:serviceTask>
    <bpmn:serviceTask id="IDX_SyncWait" name="effective_sync_wait(db, artifact, settings)"></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Wait" name="wait &gt; 0?"></bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Par_Fork"></bpmn:parallelGateway>
    <bpmn:serviceTask id="IDX_WaitReady" name="wait_ready(factory, artifact.id, seconds)"></bpmn:serviceTask>
    <bpmn:parallelGateway id="Par_Join"></bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gw_Merge"></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IDX_Decision" name="decision_for_get(db, settings, artifact)"></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Action" name="action?"></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Q_Claim" name="claim_queued_scan(db)"></bpmn:serviceTask>
    <bpmn:serviceTask id="W_Process" name="process_job(db, client, bucket, job)"></bpmn:serviceTask>
    <bpmn:serviceTask id="BLOB_Download" name="download_to(client, bucket, sha256, tmp)"></bpmn:serviceTask>
    <bpmn:serviceTask id="ENG_RunAll" name="run_all(path, engines)"></bpmn:serviceTask>
    <bpmn:serviceTask id="SC_Scan" name="scan(path, extra)"><bpmn:multiInstanceLoopCharacteristics /></bpmn:serviceTask>
    <bpmn:serviceTask id="ENG_Worst" name="worst(outcomes, threshold)"></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Verdict" name="вердикт"></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="FND_Sync" name="sync_findings(db, art, items, sla_due)"></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_VerdictMerge"></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="API_Reject" name="_reject(exc) или action=miss"></bpmn:serviceTask>
    <bpmn:serviceTask id="GW_Deny" name="handleRepository: вернуть отказ"></bpmn:serviceTask>
    <bpmn:endEvent id="GW_End_Deny" name="403, 404 или карточка"><bpmn:messageEventDefinition id="GW_End_Deny_def" /></bpmn:endEvent>
    <bpmn:serviceTask id="GW_Stream" name="streamBlob(w, r, out)"></bpmn:serviceTask>
    <bpmn:serviceTask id="API_StreamBlob" name="stream_blob(sha256, authorization)"></bpmn:serviceTask>
    <bpmn:endEvent id="GW_End_Ok" name="200 и байты"><bpmn:messageEventDefinition id="GW_End_Ok_def" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="GW_Handle" targetRef="API_Resolve" />
    <bpmn:sequenceFlow id="F2" sourceRef="API_Resolve" targetRef="API_User" />
    <bpmn:sequenceFlow id="F3" sourceRef="API_User" targetRef="ACL_Read" />
    <bpmn:sequenceFlow id="F4" sourceRef="ACL_Read" targetRef="ACL_Path" />
    <bpmn:sequenceFlow id="F5" sourceRef="ACL_Path" targetRef="Gw_Auth" />
    <bpmn:sequenceFlow id="F_AuthYes" name="да" sourceRef="Gw_Auth" targetRef="IDX_Find" />
    <bpmn:sequenceFlow id="F_AuthNo" name="нет" sourceRef="Gw_Auth" targetRef="API_Reject" />
    <bpmn:sequenceFlow id="F6" sourceRef="IDX_Find" targetRef="Gw_Found" />
    <bpmn:sequenceFlow id="F_FoundYes" name="да" sourceRef="Gw_Found" targetRef="IDX_Ensure" />
    <bpmn:sequenceFlow id="F_FoundNo" name="нет" sourceRef="Gw_Found" targetRef="UP_Miss" />
    <bpmn:sequenceFlow id="F7" sourceRef="UP_Miss" targetRef="UP_Fetch" />
    <bpmn:sequenceFlow id="F8" sourceRef="UP_Fetch" targetRef="SSRF_Check" />
    <bpmn:sequenceFlow id="F9" sourceRef="SSRF_Check" targetRef="Gw_Ssrf" />
    <bpmn:sequenceFlow id="F_SsrfYes" name="да" sourceRef="Gw_Ssrf" targetRef="BLOB_Put" />
    <bpmn:sequenceFlow id="F_SsrfNo" name="нет" sourceRef="Gw_Ssrf" targetRef="API_Reject" />
    <bpmn:sequenceFlow id="F10" sourceRef="BLOB_Put" targetRef="IDX_Ensure" />
    <bpmn:sequenceFlow id="F11" sourceRef="IDX_Ensure" targetRef="IDX_SyncWait" />
    <bpmn:sequenceFlow id="F12" sourceRef="IDX_SyncWait" targetRef="Gw_Wait" />
    <bpmn:sequenceFlow id="F_WaitYes" name="да" sourceRef="Gw_Wait" targetRef="Par_Fork" />
    <bpmn:sequenceFlow id="F_WaitNo" name="нет" sourceRef="Gw_Wait" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F13" sourceRef="Par_Fork" targetRef="IDX_WaitReady" />
    <bpmn:sequenceFlow id="F14" sourceRef="IDX_WaitReady" targetRef="Par_Join" />
    <bpmn:sequenceFlow id="F15" sourceRef="Par_Join" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_Merge" targetRef="IDX_Decision" />
    <bpmn:sequenceFlow id="F17" sourceRef="IDX_Decision" targetRef="Gw_Action" />
    <bpmn:sequenceFlow id="F_Error" name="SeccrateError" sourceRef="Gw_Action" targetRef="API_Reject" />
    <bpmn:sequenceFlow id="F_Stream" name="stream" sourceRef="Gw_Action" targetRef="GW_Stream" />
    <bpmn:sequenceFlow id="F18" sourceRef="API_Reject" targetRef="GW_Deny" />
    <bpmn:sequenceFlow id="F19" sourceRef="GW_Deny" targetRef="GW_End_Deny" />
    <bpmn:sequenceFlow id="F20" sourceRef="GW_Stream" targetRef="API_StreamBlob" />
    <bpmn:sequenceFlow id="F21" sourceRef="API_StreamBlob" targetRef="GW_End_Ok" />
    <bpmn:sequenceFlow id="W1" sourceRef="Par_Fork" targetRef="Q_Claim" />
    <bpmn:sequenceFlow id="W2" sourceRef="Q_Claim" targetRef="W_Process" />
    <bpmn:sequenceFlow id="W3" sourceRef="W_Process" targetRef="BLOB_Download" />
    <bpmn:sequenceFlow id="W4" sourceRef="BLOB_Download" targetRef="ENG_RunAll" />
    <bpmn:sequenceFlow id="W5" sourceRef="ENG_RunAll" targetRef="SC_Scan" />
    <bpmn:sequenceFlow id="W6" sourceRef="SC_Scan" targetRef="ENG_Worst" />
    <bpmn:sequenceFlow id="W7" sourceRef="ENG_Worst" targetRef="Gw_Verdict" />
    <bpmn:sequenceFlow id="W_Fail" name="FAIL" sourceRef="Gw_Verdict" targetRef="FND_Sync" />
    <bpmn:sequenceFlow id="W_PassError" name="PASS / ERROR" sourceRef="Gw_Verdict" targetRef="Gw_VerdictMerge" />
    <bpmn:sequenceFlow id="W8" sourceRef="FND_Sync" targetRef="Gw_VerdictMerge" />
    <bpmn:sequenceFlow id="W9" sourceRef="Gw_VerdictMerge" targetRef="Par_Join" />
    <bpmn:textAnnotation id="Note_Wait"><bpmn:text>ждёт вердикт не дольше effective_sync_wait секунд (по умолчанию 15)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Note_Wait_link" sourceRef="Note_Wait" targetRef="IDX_WaitReady" />
    <bpmn:textAnnotation id="Note_Verdict"><bpmn:text>PASS: статус available; ERROR: quarantine; FAIL: blocked и записи Finding</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Note_Verdict_link" sourceRef="Note_Verdict" targetRef="Gw_Verdict" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Methods">
    <bpmndi:BPMNPlane id="Plane_Methods" bpmnElement="Collab_Methods">
      <bpmndi:BPMNShape id="Pool_Dev_di" bpmnElement="Pool_Dev" isHorizontal="true"><dc:Bounds x="160" y="80" width="4680" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_SecCrate_di" bpmnElement="Pool_SecCrate" isHorizontal="true"><dc:Bounds x="160" y="300" width="4680" height="1390" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Gateway_di" bpmnElement="Lane_Gateway" isHorizontal="true"><dc:Bounds x="190" y="300" width="4650" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ResolveAPI_di" bpmnElement="Lane_ResolveAPI" isHorizontal="true"><dc:Bounds x="190" y="480" width="4650" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AccessControl_di" bpmnElement="Lane_AccessControl" isHorizontal="true"><dc:Bounds x="190" y="590" width="4650" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ArtifactIndex_di" bpmnElement="Lane_ArtifactIndex" isHorizontal="true"><dc:Bounds x="190" y="700" width="4650" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_UpstreamClient_di" bpmnElement="Lane_UpstreamClient" isHorizontal="true"><dc:Bounds x="190" y="810" width="4650" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SsrfGuard_di" bpmnElement="Lane_SsrfGuard" isHorizontal="true"><dc:Bounds x="190" y="920" width="4650" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ScanQueue_di" bpmnElement="Lane_ScanQueue" isHorizontal="true"><dc:Bounds x="190" y="1030" width="4650" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Worker_di" bpmnElement="Lane_Worker" isHorizontal="true"><dc:Bounds x="190" y="1140" width="4650" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BlobStore_di" bpmnElement="Lane_BlobStore" isHorizontal="true"><dc:Bounds x="190" y="1250" width="4650" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ScanEngine_di" bpmnElement="Lane_ScanEngine" isHorizontal="true"><dc:Bounds x="190" y="1360" width="4650" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Scanner_di" bpmnElement="Lane_Scanner" isHorizontal="true"><dc:Bounds x="190" y="1470" width="4650" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Findings_di" bpmnElement="Lane_Findings" isHorizontal="true"><dc:Bounds x="190" y="1580" width="4650" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dev_Start_di" bpmnElement="Dev_Start"><dc:Bounds x="272" y="152" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="250" y="192" width="80" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dev_Send_di" bpmnElement="Dev_Send"><dc:Bounds x="375" y="135" width="210" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dev_Wait_di" bpmnElement="Dev_Wait"><dc:Bounds x="3835" y="145" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="3820" y="125" width="80" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dev_Denied_di" bpmnElement="Dev_Denied"><dc:Bounds x="4072" y="197" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="4070" y="237" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dev_End_Bad_di" bpmnElement="Dev_End_Bad"><dc:Bounds x="4202" y="197" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="4185" y="237" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dev_Got_di" bpmnElement="Dev_Got"><dc:Bounds x="4622" y="107" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="4600" y="91" width="80" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dev_End_Ok_di" bpmnElement="Dev_End_Ok"><dc:Bounds x="4742" y="107" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="4715" y="147" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Handle_di" bpmnElement="GW_Handle"><dc:Bounds x="375" y="308" width="210" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="API_Resolve_di" bpmnElement="API_Resolve"><dc:Bounds x="375" y="500" width="210" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="API_User_di" bpmnElement="API_User"><dc:Bounds x="625" y="500" width="210" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ACL_Read_di" bpmnElement="ACL_Read"><dc:Bounds x="625" y="610" width="210" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ACL_Path_di" bpmnElement="ACL_Path"><dc:Bounds x="875" y="610" width="210" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Auth_di" bpmnElement="Gw_Auth" isMarkerVisible="true"><dc:Bounds x="1145" y="620" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1135" y="672" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IDX_Find_di" bpmnElement="IDX_Find"><dc:Bounds x="1265" y="720" width="210" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Found_di" bpmnElement="Gw_Found" isMarkerVisible="true"><dc:Bounds x="1545" y="730" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1600" y="716" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UP_Miss_di" bpmnElement="UP_Miss"><dc:Bounds x="1465" y="830" width="210" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UP_Fetch_di" bpmnElement="UP_Fetch"><dc:Bounds x="1705" y="830" width="210" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SSRF_Check_di" bpmnElement="SSRF_Check"><dc:Bounds x="1705" y="940" width="210" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Ssrf_di" bpmnElement="Gw_Ssrf" isMarkerVisible="true"><dc:Bounds x="1985" y="950" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2042" y="985" width="72" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BLOB_Put_di" bpmnElement="BLOB_Put"><dc:Bounds x="1905" y="1270" width="210" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IDX_Ensure_di" bpmnElement="IDX_Ensure"><dc:Bounds x="2155" y="720" width="210" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IDX_SyncWait_di" bpmnElement="IDX_SyncWait"><dc:Bounds x="2405" y="720" width="210" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Wait_di" bpmnElement="Gw_Wait" isMarkerVisible="true"><dc:Bounds x="2685" y="730" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2680" y="784" width="62" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Par_Fork_di" bpmnElement="Par_Fork"><dc:Bounds x="2775" y="730" width="50" height="50" /></bpmndi:BPMNShape>
