  <bpmn:collaboration id="Collaboration_SecCrate">
    <bpmn:participant id="Participant_SecCrate" name="SecCrate — получить зависимость" processRef="Process_GetArtifact" />
  </bpmn:collaboration>
  <bpmn:collaboration id="Collaboration_1p4x4zd">
    <bpmn:participant id="Participant_09eqrsx" processRef="Process_GetArtifact" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GetArtifact" name="Получить зависимость через SecCrate" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Dev" name="Разработчик" />
      <bpmn:lane id="Lane_Platform" name="Платформа SecCrate" />
      <bpmn:lane id="Lane_Scan" name="Сканирование" />
      <bpmn:lane id="Lane_04k6vgk" name="Разработчик / Клиент">
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Forbidden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Blocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Quarantine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_12ovckq">
        <bpmn:flowNodeRef>Task_Auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Cache</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ssrf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Ssrf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Engines</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Worst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stream</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Wait</bpmn:flowNodeRef>
        <bpmn:childLaneSet id="LaneSet_1swzh4g">
          <bpmn:lane id="Lane_0wpxm42" name="Платорма SecCrate">
            <bpmn:flowNodeRef>Task_Auth</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Gw_Auth</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Task_Find</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Gw_Cache</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Task_Ssrf</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Gw_Ssrf</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Task_Fetch</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Task_Pending</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Gw_Status</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Task_Stream</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Gw_Wait</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Lane_0nvrid9" name="Сканеры">
            <bpmn:flowNodeRef>Task_Claim</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Task_Engines</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Timer_Wait</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Task_Worst</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Gw_Verdict</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_Need" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="Flow_To_Auth" sourceRef="Task_Request" targetRef="Task_Auth" />
    <bpmn:sequenceFlow id="Flow_To_GwAuth" sourceRef="Task_Auth" targetRef="Gw_Auth" />
    <bpmn:sequenceFlow id="Flow_Auth_No" name="нет" sourceRef="Gw_Auth" targetRef="End_Denied" />
    <bpmn:sequenceFlow id="Flow_Auth_Yes" name="да" sourceRef="Gw_Auth" targetRef="Task_Find" />
    <bpmn:sequenceFlow id="Flow_To_Cache" sourceRef="Task_Find" targetRef="Gw_Cache" />
    <bpmn:sequenceFlow id="Flow_Cache_Yes" name="да" sourceRef="Gw_Cache" targetRef="Gw_Status" />
    <bpmn:sequenceFlow id="Flow_Cache_No" name="нет" sourceRef="Gw_Cache" targetRef="Task_Ssrf" />
    <bpmn:sequenceFlow id="Flow_To_GwSsrf" sourceRef="Task_Ssrf" targetRef="Gw_Ssrf" />
    <bpmn:sequenceFlow id="Flow_Ssrf_No" name="нет" sourceRef="Gw_Ssrf" targetRef="End_Forbidden" />
    <bpmn:sequenceFlow id="Flow_Ssrf_Yes" name="да" sourceRef="Gw_Ssrf" targetRef="Task_Fetch" />
    <bpmn:sequenceFlow id="Flow_To_Pending" sourceRef="Task_Fetch" targetRef="Task_Pending" />
    <bpmn:sequenceFlow id="Flow_Pending_Status" sourceRef="Task_Pending" targetRef="Gw_Status" />
    <bpmn:sequenceFlow id="Flow_Status_Block" name="blocked" sourceRef="Gw_Status" targetRef="End_Blocked" />
    <bpmn:sequenceFlow id="Flow_Status_Pending" name="pending" sourceRef="Gw_Status" targetRef="Task_Stream" />
    <bpmn:sequenceFlow id="Flow_Fail" name="FAIL" sourceRef="Gw_Verdict" targetRef="End_Blocked" />
    <bpmn:sequenceFlow id="Flow_Pass" name="PASS" sourceRef="Gw_Verdict" targetRef="Task_Stream" />
    <bpmn:sequenceFlow id="Flow_Stream_Ok" sourceRef="Task_Stream" targetRef="End_Ok" />
    <bpmn:sequenceFlow id="Flow_Wait_No" name="нет" sourceRef="Gw_Wait" targetRef="Task_Stream" />
    <bpmn:sequenceFlow id="Flow_Wait_Yes" name="да" sourceRef="Gw_Wait" targetRef="Timer_Wait" />
    <bpmn:sequenceFlow id="Flow_After_Timer" sourceRef="Timer_Wait" targetRef="Task_Claim" />
    <bpmn:sequenceFlow id="Flow_Claim" sourceRef="Task_Claim" targetRef="Task_Engines" />
    <bpmn:sequenceFlow id="Flow_Engines" sourceRef="Task_Engines" targetRef="Task_Worst" />
    <bpmn:sequenceFlow id="Flow_Worst" sourceRef="Task_Worst" targetRef="Gw_Verdict" />
    <bpmn:sequenceFlow id="Flow_Error" name="ERROR" sourceRef="Gw_Verdict" targetRef="End_Quarantine" />
    <bpmn:userTask id="Task_Request" name="Запросить артефакт">
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Auth</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Start_Need" name="Нужен пакет">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="End_Forbidden" name="Адрес запрещён">
      <bpmn:incoming>Flow_Ssrf_No</bpmn:incoming>
      <bpmn:errorEventDefinition id="Err_Forbidden" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Blocked" name="Карточка блокировки">
      <bpmn:incoming>Flow_Status_Block</bpmn:incoming>
      <bpmn:incoming>Flow_Fail</bpmn:incoming>
      <bpmn:errorEventDefinition id="Err_Blocked" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Retry" name="Повторите запрос">
      <bpmn:incoming>Flow_0tfg1xr</bpmn:incoming>
      <bpmn:errorEventDefinition id="Err_Retry" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0bb8kzi" sourceRef="Task_Stream" targetRef="Gw_Wait" />
    <bpmn:serviceTask id="Task_Auth" name="Проверить токен и выдачу">
      <bpmn:incoming>Flow_To_Auth</bpmn:incoming>
      <bpmn:outgoing>Flow_To_GwAuth</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Auth" name="Доступ есть?" default="Flow_Auth_Yes">
      <bpmn:incoming>Flow_To_GwAuth</bpmn:incoming>
      <bpmn:outgoing>Flow_Auth_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Auth_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Denied" name="Нет доступа">
      <bpmn:incoming>Flow_Auth_No</bpmn:incoming>
      <bpmn:errorEventDefinition id="Err_Denied" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Find" name="Найти артефакт">
      <bpmn:incoming>Flow_Auth_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Cache</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Cache" name="Уже в хранилище?" default="Flow_Cache_Yes">
      <bpmn:incoming>Flow_To_Cache</bpmn:incoming>
      <bpmn:outgoing>Flow_Cache_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cache_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Ssrf" name="Проверить адрес upstream">
      <bpmn:incoming>Flow_Cache_No</bpmn:incoming>
      <bpmn:outgoing>Flow_To_GwSsrf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Ssrf" name="Адрес разрешён?" default="Flow_Ssrf_Yes">
      <bpmn:incoming>Flow_To_GwSsrf</bpmn:incoming>
      <bpmn:outgoing>Flow_Ssrf_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ssrf_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Fetch" name="Скачать пакет и сохранить в CAS">
      <bpmn:incoming>Flow_Ssrf_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Pending</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Pending" name="Создать артефакт pending и задачу скана">
      <bpmn:incoming>Flow_To_Pending</bpmn:incoming>
      <bpmn:outgoing>Flow_Pending_Status</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Status" name="Какой статус?">
      <bpmn:incoming>Flow_Cache_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Pending_Status</bpmn:incoming>
      <bpmn:outgoing>Flow_Status_Block</bpmn:outgoing>
      <bpmn:outgoing>Flow_Status_Pending</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0tfg1xr" sourceRef="Task_Stream" targetRef="End_Retry" />
    <bpmn:serviceTask id="Task_Claim" name="Взять задачу из очереди">
      <bpmn:incoming>Flow_After_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Claim</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Engines" name="Проверить Grype, Trivy и OSV">
      <bpmn:incoming>Flow_Claim</bpmn:incoming>
      <bpmn:outgoing>Flow_Engines</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Timer_Wait" name="Не дольше 15 секунд">
      <bpmn:incoming>Flow_Wait_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_After_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_15">
        <bpmn:timeDuration>PT15S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_Worst" name="Выбрать самый строгий вердикт">
      <bpmn:incoming>Flow_Engines</bpmn:incoming>
      <bpmn:outgoing>Flow_Worst</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Verdict" name="Вердикт">
      <bpmn:incoming>Flow_Worst</bpmn:incoming>
      <bpmn:outgoing>Flow_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fail</bpmn:outgoing>
      <bpmn:outgoing>Flow_Error</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Stream" name="Отдать файл потоком">
      <bpmn:incoming>Flow_Pass</bpmn:incoming>
      <bpmn:incoming>Flow_Status_Pending</bpmn:incoming>
      <bpmn:incoming>Flow_Wait_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Stream_Ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_0bb8kzi</bpmn:outgoing>
      <bpmn:outgoing>Flow_0tfg1xr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Wait" name="Ждать скан?" default="Flow_Wait_Yes">
      <bpmn:incoming>Flow_0bb8kzi</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wait_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Quarantine" name="Карантин">
      <bpmn:incoming>Flow_Error</bpmn:incoming>
      <bpmn:errorEventDefinition id="Err_Quarantine" />
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Ok" name="Пакет получен">
      <bpmn:incoming>Flow_Stream_Ok</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
